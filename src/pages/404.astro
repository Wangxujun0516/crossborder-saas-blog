---
import BlogLayout from "../layouts/BlogLayout.astro";
---

<BlogLayout title="404 — Page Not Found" description="The page you're looking for doesn't exist.">
  <section style="text-align: center; padding: 4rem 0;">
    <h1>404</h1>
    <p style="font-size: 1.125rem; margin-bottom: 2rem;">
      Page not found. It may have moved or doesn't exist yet.
    </p>
    <a href="/" style="color: #2563eb;">← Back to home</a>
  </section>
</BlogLayout>
