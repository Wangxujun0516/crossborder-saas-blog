---
import BlogLayout from "../layouts/BlogLayout.astro";
---

<BlogLayout title="404 - Page Not Found" description="The page you're looking for doesn't exist.">
  <section class="py-24 lg:py-32">
    <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="w-24 h-24 rounded-full bg-accent/10 flex items-center justify-center mx-auto mb-6">
        <svg class="w-12 h-12 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
      </div>
      
      <h1 class="text-3xl lg:text-4xl font-bold text-text mb-4">Page Not Found</h1>
      <p class="text-text-secondary text-lg mb-8">
        The page you're looking for doesn't exist or has been moved.
      </p>
      
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href="/"
          class="inline-flex items-center justify-center px-6 py-3 bg-primary hover:bg-primary-hover text-white font-medium rounded-lg transition-colors"
        >
          Go Back Home
        </a>
        <a
          href="/blog"
          class="inline-flex items-center justify-center px-6 py-3 bg-white border border-border hover:border-primary text-text font-medium rounded-lg transition-colors"
        >
          Browse Articles
        </a>
      </div>
    </div>
  </section>
</BlogLayout>
