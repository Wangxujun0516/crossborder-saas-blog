---
import { getCollection, render } from "astro:content";
import BlogLayout from "../../layouts/BlogLayout.astro";
import PostCard from "../../components/PostCard.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id.replace(/\.md$/, "") },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

const allPosts = (await getCollection("blog"))
  .filter((p) => !p.data.draft && p.id !== post.id)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const relatedPosts = allPosts.filter(p => 
  p.data.tags.some(tag => post.data.tags.includes(tag))
).slice(0, 3);

const toc = headings.filter(h => h.depth >= 2 && h.depth <= 3);
---

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const tocItems = document.querySelectorAll('[data-toc-item]');
    
    tocItems.forEach(item => {
      item.addEventListener('click', (e) => {
        e.preventDefault();
        const href = item.getAttribute('href');
        const target = document.querySelector(href);
        if (target) {
          target.scrollIntoView({ behavior: 'smooth' });
        }
      });
    });

    const shareButtons = document.querySelectorAll('[data-share-button]');
    shareButtons.forEach(button => {
      button.addEventListener('click', () => {
        const platform = button.getAttribute('data-platform');
        const url = encodeURIComponent(window.location.href);
        const title = encodeURIComponent(document.title);
        
        let shareUrl = '';
        switch (platform) {
          case 'twitter':
            shareUrl = `https://twitter.com/intent/tweet?url=${url}&text=${title}`;
            break;
          case 'linkedin':
            shareUrl = `https://www.linkedin.com/shareArticle?url=${url}&title=${title}`;
            break;
          case 'email':
            shareUrl = `mailto:?subject=${title}&body=${url}`;
            break;
          case 'copy':
            navigator.clipboard.writeText(window.location.href);
            button.innerHTML = '<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>';
            setTimeout(() => {
              button.innerHTML = '<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg>';
            }, 2000);
            return;
        }
        
        if (shareUrl) {
          window.open(shareUrl, '_blank', 'width=600,height=400');
        }
      });
    });

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        const id = entry.target.getAttribute('id');
        const tocItem = document.querySelector(`[data-toc-item][href="#${id}"]`);
        if (tocItem) {
          if (entry.isIntersecting) {
            tocItems.forEach(item => item.classList.remove('text-primary'));
            tocItem.classList.add('text-primary');
          }
        }
      });
    }, { rootMargin: '-20% 0% -35% 0%' });

    document.querySelectorAll('h2, h3').forEach(heading => {
      observer.observe(heading);
    });
  });
</script>

<BlogLayout
  title={post.data.title}
  description={post.data.description}
  ogType="article"
>
  <article class="py-12 lg:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="lg:grid lg:grid-cols-12 lg:gap-8">
        <div class="lg:col-span-8">
          <header class="mb-10">
            <div class="flex items-center gap-2 mb-4">
              {post.data.tags.map((tag) => (
                <a
                  href={`/blog?tag=${tag}`}
                  class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-bg-tertiary text-text-secondary hover:bg-primary hover:text-white transition-colors"
                >
                  {tag}
                </a>
              ))}
            </div>
            
            <h1 class="text-3xl lg:text-4xl xl:text-5xl font-bold text-text mb-6 leading-tight">
              {post.data.title}
            </h1>
            
            <p class="text-lg text-text-secondary mb-6">
              {post.data.description}
            </p>
            
            <div class="flex flex-col sm:flex-row items-start sm:items-center gap-4 text-text-muted text-sm">
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center">
                  <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                  </svg>
                </div>
                <div>
                  <p class="font-medium text-text">CrossBorder SaaS Team</p>
                  <p class="text-text-muted">China SaaS Growth Experts</p>
                </div>
              </div>
              
              <div class="flex items-center gap-6">
                <time datetime={post.data.pubDate.toISOString()}>
                  {post.data.pubDate.toLocaleDateString("en-US", {
                    year: "numeric",
                    month: "long",
                    day: "numeric",
                  })}
                </time>
                <span class="flex items-center gap-1">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                  5 min read
                </span>
              </div>
            </div>
          </header>

          <div class="prose prose-lg max-w-none text-text mb-10">
            <Content />
          </div>

          <div class="border-t border-border pt-8 mb-10">
            <h3 class="text-lg font-semibold text-text mb-4">Share this article</h3>
            <div class="flex items-center gap-3">
              <button
                data-share-button
                data-platform="twitter"
                class="p-3 rounded-lg bg-bg-tertiary hover:bg-primary hover:text-white text-text-secondary transition-all"
                aria-label="Share on Twitter"
              >
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z" />
                </svg>
              </button>
              <button
                data-share-button
                data-platform="linkedin"
                class="p-3 rounded-lg bg-bg-tertiary hover:bg-primary hover:text-white text-text-secondary transition-all"
                aria-label="Share on LinkedIn"
              >
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z" />
                </svg>
              </button>
              <button
                data-share-button
                data-platform="email"
                class="p-3 rounded-lg bg-bg-tertiary hover:bg-primary hover:text-white text-text-secondary transition-all"
                aria-label="Share via Email"
              >
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
              </button>
              <button
                data-share-button
                data-platform="copy"
                class="p-3 rounded-lg bg-bg-tertiary hover:bg-primary hover:text-white text-text-secondary transition-all"
                aria-label="Copy link"
              >
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                </svg>
              </button>
            </div>
          </div>
        </div>

        <aside class="lg:col-span-4">
          <div class="lg:sticky lg:top-24">
            {toc.length > 0 && (
              <div class="bg-white rounded-xl border border-border p-6 mb-8">
                <h3 class="text-lg font-semibold text-text mb-4">Table of Contents</h3>
                <nav class="space-y-2">
                  {toc.map((heading) => (
                    <a
                      key={heading.slug}
                      data-toc-item
                      href={`#${heading.slug}`}
                      class={`block text-sm transition-colors ${
                        heading.depth === 2 
                          ? 'text-text-secondary hover:text-primary pl-0' 
                          : 'text-text-muted hover:text-primary pl-4'
                      }`}
                    >
                      {heading.text}
                    </a>
                  ))}
                </nav>
              </div>
            )}

            {relatedPosts.length > 0 && (
              <div class="bg-white rounded-xl border border-border p-6">
                <h3 class="text-lg font-semibold text-text mb-4">Related Articles</h3>
                <div class="space-y-4">
                  {relatedPosts.map((relatedPost) => {
                    const slug = relatedPost.id.replace(/\.md$/, "");
                    return (
                      <article key={relatedPost.id} class="group flex gap-3">
                        <div class="w-16 h-16 rounded-lg overflow-hidden flex-shrink-0">
                          <img
                            src={relatedPost.data.image || "https://neeko-copilot.bytedance.net/api/text_to_image?prompt=saas%20business%20article&image_size=square"}
                            alt={relatedPost.data.title}
                            class="w-full h-full object-cover transition-transform group-hover:scale-105"
                          />
                        </div>
                        <div class="flex-1 min-w-0">
                          <h4 class="font-medium text-text text-sm line-clamp-2 group-hover:text-primary transition-colors">
                            <a href={`/blog/${slug}`}>{relatedPost.data.title}</a>
                          </h4>
                          <time datetime={relatedPost.data.pubDate.toISOString()} class="text-text-muted text-xs">
                            {relatedPost.data.pubDate.toLocaleDateString("en-US", {
                              month: "short",
                              day: "numeric",
                            })}
                          </time>
                        </div>
                      </article>
                    );
                  })}
                </div>
              </div>
            )}
          </div>
        </aside>
      </div>
    </div>
  </article>
</BlogLayout>
