---
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";

const footerLinks = {
  product: [
    { label: "Blog", href: "/blog" },
    { label: "Topics", href: "/blog" },
    { label: "Resources", href: "/" },
    { label: "Newsletter", href: "#" },
  ],
  company: [
    { label: "About", href: "/about" },
    { label: "Contact", href: "/" },
    { label: "Privacy", href: "/" },
    { label: "Terms", href: "/" },
  ],
  connect: [
    { label: "Twitter", href: "/" },
    { label: "LinkedIn", href: "/" },
    { label: "Email", href: "/" },
  ],
};
---

<footer class="bg-text py-16">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 mb-12">
      <div class="lg:col-span-1">
        <a href="/" class="flex items-center gap-2 mb-4">
          <div class="w-8 h-8 rounded-lg bg-primary flex items-center justify-center">
            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
            </svg>
          </div>
          <span class="text-lg font-semibold text-white">{SITE_TITLE}</span>
        </a>
        <p class="text-gray-400 text-sm mb-6 max-w-xs">
          {SITE_DESCRIPTION}
        </p>
        <div class="flex items-center gap-4">
          {footerLinks.connect.map((link) => (
            <a
              href={link.href}
              class="text-gray-400 hover:text-white transition-colors"
              aria-label={link.label}
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
              </svg>
            </a>
          ))}
        </div>
      </div>
      
      <div>
        <h3 class="text-white font-semibold mb-4">Product</h3>
        <ul class="space-y-3">
          {footerLinks.product.map((link) => (
            <li>
              <a href={link.href} class="text-gray-400 hover:text-white transition-colors text-sm">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
      
      <div>
        <h3 class="text-white font-semibold mb-4">Company</h3>
        <ul class="space-y-3">
          {footerLinks.company.map((link) => (
            <li>
              <a href={link.href} class="text-gray-400 hover:text-white transition-colors text-sm">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
      
      <div>
        <h3 class="text-white font-semibold mb-4">Newsletter</h3>
        <p class="text-gray-400 text-sm mb-4">
          Get weekly insights on China SaaS expansion delivered to your inbox.
        </p>
        <form class="space-y-3">
          <div class="relative">
            <input
              type="email"
              placeholder="your@email.com"
              class="w-full px-4 py-3 rounded-lg bg-white/10 border border-white/20 text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-primary"
            />
          </div>
          <button
            type="submit"
            class="w-full px-4 py-3 bg-primary hover:bg-primary-hover text-white font-medium rounded-lg transition-colors"
          >
            Subscribe
          </button>
        </form>
      </div>
    </div>
    
    <div class="border-t border-white/10 pt-8 flex flex-col md:flex-row justify-between items-center gap-4">
      <p class="text-gray-400 text-sm">
        &copy; {new Date().getFullYear()} {SITE_TITLE}. All rights reserved.
      </p>
      <p class="text-gray-400 text-sm">
        Made with focus on Chinese SaaS going global
      </p>
    </div>
  </div>
</footer>
