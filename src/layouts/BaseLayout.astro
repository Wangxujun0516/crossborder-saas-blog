---
import { SITE_DESCRIPTION, BASE_URL } from "../consts";
import "../styles/global.css";

export interface Props {
  title: string;
  description: string;
  ogType?: string;
  canonical?: string;
  ogImage?: string;
  pubDate?: Date;
  tags?: string[];
  author?: string;
}

const {
  title,
  description,
  ogType = "website",
  canonical,
  ogImage = "/default-og.png",
  pubDate,
  tags = [],
  author = "CrossBorder SaaS",
} = Astro.props;

const pageUrl = canonical ?? Astro.url;
const pageUrlStr =
  typeof pageUrl === "string" ? pageUrl : pageUrl?.toString() ?? "/";
const origin =
  typeof pageUrl === "string"
    ? new URL(pageUrl).origin
    : pageUrl?.origin ?? BASE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="google-site-verification" content="fCREiD40GgsGXBlR7Q_xy4qFlx7qhWy67h83Wdy-Ou4" />
    <meta name="google-site-verification" content="LeXgBAjEF47mYRZaOJi0bk1JTXGP7pEurjmq47Ib6I0" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />

    <!-- Canonical -->
    <link rel="canonical" href={pageUrlStr} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={pageUrlStr} />
    <meta property="og:image" content={`${origin}${ogImage}`} />
    <meta property="og:site_name" content="CrossBorder SaaS" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${origin}${ogImage}`} />

    <!-- RSS discovery link -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title="CrossBorder SaaS RSS"
      href="/rss.xml"
    />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    
    <!-- Umami Analytics - Deferred to avoid blocking page render -->
    <script defer src="https://cloud.umami.is/script.js" data-website-id="eb2b8394-4492-41b4-b2ee-39c7c3fbda1d"></script>
    
    <title>{title}</title>
  </head>
  <body>
    <slot />

    <!-- JSON-LD Structured Data -->
    {ogType === "article" ? (
      <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "BlogPosting",
        headline: title,
        description,
        datePublished: pubDate?.toISOString(),
        author: { "@type": "Person", name: author },
        publisher: {
          "@type": "Organization",
          name: "CrossBorder SaaS",
        },
        mainEntityOfPage: { "@type": "WebPage", "@id": pageUrlStr },
        keywords: tags.join(", "),
      })} />
    ) : (
      <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "WebSite",
        name: "CrossBorder SaaS",
        url: origin,
        description: SITE_DESCRIPTION,
      })} />
    )}
  </body>
</html>
