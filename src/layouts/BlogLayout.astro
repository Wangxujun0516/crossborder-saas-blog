---
import BaseLayout from "./BaseLayout.astro";
import type { Props as BaseProps } from "./BaseLayout.astro";
import { SITE_TITLE, SITE_DESCRIPTION, BASE_URL } from "../consts";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

export interface Props extends BaseProps {}

const { title, description, ogType, canonical } = Astro.props;
---

<BaseLayout
  title={`${title} | ${SITE_TITLE}`}
  description={description}
  ogType={ogType}
  canonical={canonical}
>
  <Header />
  
  <main class="min-h-screen bg-bg-secondary pt-20 lg:pt-24">
    <slot />
  </main>
  
  <Footer />
</BaseLayout>
